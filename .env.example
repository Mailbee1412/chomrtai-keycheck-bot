# ===== Discord Bot =====
# ไปที่ https://discord.com/developers/applications -> New Application -> Bot -> Reset Token
DISCORD_TOKEN=ใส่_โทเคน_ของบอท_ตรงนี้
DISCORD_CLIENT_ID=ใส่_Application_ID_ตรงนี้
DISCORD_GUILD_ID=ใส่_ID_เซิร์ฟเวอร์_(ไม่บังคับ)
# ชื่อบอทที่แสดงบน embed (และใช้เป็นชื่อผู้ส่งข้อความต้อนรับ)
SHOP_NAME=สมฤทัย

# ===== LinkAPI (เช็คยอดข้อความในคีย์) =====
# วางคีย์ sk-... ในห้อง แล้วบอทจะเช็คจำนวนข้อความคงเหลือให้
# จำกัดให้เช็คได้เฉพาะบางห้อง (คั่นด้วย , ปล่อยว่าง = ทุกห้อง)
LINKAPI_CHANNEL_IDS=
LINKAPI_BASE=https://linkapi.ai
# ช่องสำหรับโพสต์ข้อความต้อนรับ + วิธีเช็ค (โพสต์ครั้งเดียวตอนบอทออนไลน์ ปล่อยว่าง = ปิด)
LINKAPI_WELCOME_CHANNEL_ID=
# หน่วยโควตาที่เว็บแสดง
LINKAPI_QUOTA_UNIT=USD
# ตัวหารแปลงโควตาดิบเป็นหน่วยที่เว็บแสดง (ค่าจริงของเว็บ = 500000)
LINKAPI_QUOTA_PER_UNIT=500000
# แจ้งเตือนเมื่อเหลือต่ำกว่าค่านี้
LINKAPI_LOW_ALERT=1
# บัญชีที่แอดมินล็อกอินไว้ เพื่อให้ Excel ระบุชื่อบัญชี/อีเมล
# วิธีหา: ล็อกอิน https://linkapi.ai > F12 > Application > Local Storage > คัดลอก access_token กับ user_id
LINKAPI_ACCESS_TOKEN=
LINKAPI_USER_ID=
# เก็บคีย์เต็มลง Excel ด้วยไหม (true = เก็บ, false = เก็บเฉพาะคีย์ที่ซ่อนแล้ว)
LINKAPI_STORE_FULL_KEY=false
# ตำแหน่งไฟล์ Excel (ปล่อยว่าง = data/linkapi-keys.xlsx)
LINKAPI_EXCEL_PATH=
# จำกัดให้เช็คได้เฉพาะคีย์ของบัญชีที่ล็อกอินเท่านั้น (true = เปิด)
LINKAPI_STRICT_ACCOUNT=false
# อายุ cache รายการคีย์ (ms) — ค่าเริ่มต้น 1800000 (30 นาที)
LINKAPI_KEY_CACHE_TTL_MS=
# อายุ cache ราคาโมเดล (ms) — ค่าเริ่มต้น 1800000 (30 นาที)
LINKAPI_PRICING_TTL_MS=
# โหมดตอบกลับ: thread (ค่าเริ่มต้น) = สร้าง private thread ต่อคน, dm = ส่ง DM, off = ตอบในห้อง
LINKAPI_PRIVATE_MODE=thread
# เปิด/ปิดเช็คอัตโนมัติเมื่อพิมพ์คีย์ในแชท (true/false) — ค่าเริ่มต้น false (ใช้คำสั่ง /เช็คคีย์)
LINKAPI_MESSAGE_CHECK=false
# จำนวนคีย์สูงสุดต่อข้อความ
LINKAPI_MAX_KEYS=10
# รายชื่อโมเดลสำรอง (กรณีคีย์ไม่ได้ตั้ง Model Limits) — บอทคำนวณเฉพาะโมเดลที่ขึ้นต้น [次]
# รูปแบบ JSON: {"gemini-3.1-pro-preview": 1, "gemini-3.8-flash": 1} หรือข้อความ: gemini-3.1-pro-preview=1,gemini-3.8-flash=1
LINKAPI_MODEL_LIMITS=
# ราคาต่อครั้งที่บังคับเองสำหรับโมเดลที่ไม่มี [次] (เช่น -r) — ทับราคาจาก /api/pricing
# รูปแบบ JSON: {"gemini-3.1-pro-preview-r": 0.05} หรือข้อความ: gemini-3.1-pro-preview-r=0.05
LINKAPI_PRICE_OVERRIDES=

# ===== ฟอร์มแจ้งปัญหา (Support Form) =====
# ช่องสำหรับวางปุ่ม "แจ้งปัญหา" (บอทจะโพสต์/แก้ไขข้อความปุ่มให้ครั้งเดียว)
SUPPORT_FORM_CHANNEL_ID=
# ช่องปลายทางที่จะสร้างโพสต์เคส — แนะนำให้เป็น "ฟอรัม" (Forum) เพื่อให้ใช้แท็ก + ล็อกช่องได้
SUPPORT_FORM_TARGET_CHANNEL_ID=
# ประเภทช่องปลายทาง: text | forum (ค่าเริ่มต้น text)
SUPPORT_FORM_TARGET_TYPE=forum
# ID ของแท็กฟอรัม เรียงตามสถานะ pending,in-progress,resolved — ถ้าปล่อยว่าง บอทจะจับจากชื่อแท็ก "รอแก้ไข/กำลังแก้ไข/แก้ไขแล้ว"
# ตัวอย่าง: 111111111111111111,222222222222222222,333333333333333333
SUPPORT_FORM_FORUM_TAG_ID=
# ข้อความบนปุ่มเปิดฟอร์ม
SUPPORT_FORM_BUTTON_LABEL=แจ้งปัญหา
# ตำแหน่งไฟล์เก็บข้อมูลเคส (ปล่อยว่าง = data/support-requests.json)
SUPPORT_FORM_DATA_PATH=
# Role ที่ "อนุญาตให้กดปุ่มแจ้งปัญหา" (คั่นด้วย , ปล่อยว่าง = ทุกคน)
SUPPORT_FORM_ALLOWED_ROLE_IDS=
# Role ของทีมงานที่จะถูกแท็กในโพสต์เคสใหม่ (คั่นด้วย ,)
SUPPORT_FORM_NOTIFY_ROLE_IDS=
# Role ทีมงานที่มีสิทธิ์กดปุ่มปิดเคส (ปล่อยว่าง = ใช้ SUPPORT_FORM_NOTIFY_ROLE_IDS และผู้มี Manage Messages)
SUPPORT_FORM_STAFF_ROLE_IDS=

# ===== Shop (ร้านค้า) =====
# ห้องสำหรับวางแผงร้านค้า (ปล่อยว่าง = ไม่โพสต์แผง)
SHOP_CHANNEL_ID=
# หมวดหมู่ (Category) สำหรับสร้างห้องออเดอร์ (ปล่อยว่าง = ใช้หมวดเดียวกับช่องร้าน)
SHOP_CATEGORY_ID=
# ห้องสำหรับส่งสรุปยอด/แจ้งเตือนออเดอร์ (ปล่อยว่าง = ไม่ส่ง)
SHOP_ORDER_LOG_CHANNEL_ID=
# เขตเวลาสำหรับนับรอบวัน/ตั้งเวลาสรุปยอด
SHOP_TIMEZONE=Asia/Bangkok
# เวลาส่งสรุปยอดรายได้รายวัน (HH:MM ตาม SHOP_TIMEZONE, ค่าเริ่มต้น 23:59)
SHOP_DAILY_SUMMARY_TIME=23:59
# สัญลักษณ์สกุลเงิน
SHOP_CURRENCY_SYMBOL=฿
# รูป QR ร้าน (path ไฟล์รูปบนเครื่อง, ปล่อยว่าง = ไม่แนบ) — แนบในห้องออเดอร์
SHOP_QR_IMAGE_PATH=
# Role ทีมงานร้าน (ปล่อยว่าง = ใช้ SUPPORT_FORM_STAFF_ROLE_IDS)
SHOP_STAFF_ROLE_IDS=
# แท็กทีมงานในห้องออเดอร์ (true = แท็ก, false = ไม่แท็ก เหมาะตอนเทส)
SHOP_MENTION_STAFF=true
# ผู้ให้บริการอ่านสลิป: easyslip (ค่าเริ่มต้น, ยืนยันกับธนาคารจริง) หรือ gemini (อ่านจากรูป)
SHOP_SLIP_VERIFY_PROVIDER=easyslip
# คีย์ผู้ให้บริการอ่านสลิป (ปล่อยว่าง = ปิดการอ่านสลิปอัตโนมัติ ใช้ยอดที่ผู้ซื้อกรอก)
#   - easyslip: EasySlip API key
#   - gemini  : Google AI Studio API key (คีย์เจมิไน)
SHOP_SLIP_VERIFY_KEY=
# เปลี่ยน base URL ของผู้ให้บริการ (ปล่อยว่าง = ใช้ค่าเริ่มต้นของผู้ให้บริการ)
SHOP_SLIP_VERIFY_BASE=
# โมเดลของ Gemini (ใช้เมื่อ SHOP_SLIP_VERIFY_PROVIDER=gemini)
SHOP_SLIP_VERIFY_MODEL=gemini-2.5-flash
# ถือว่าสลิป "เก่า" ถ้าเวลาที่โอนเกินกี่ชั่วโมงที่แล้ว (ใช้แจ้งเตือนทีมงาน)
SHOP_SLIP_MAX_AGE_HOURS=24
